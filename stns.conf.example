# stnsd configuration.
#
# Install this as ${SYSCONFDIR}/stns/server/stns.conf, which is
#   /usr/pkg/etc/stns/server/stns.conf   on NetBSD
#   /usr/local/etc/stns/server/stns.conf on FreeBSD and DragonFly
#
# It holds password hashes, so keep it readable by root only.  The schema is
# upstream STNS's, so a file written for that server is read by this one
# unchanged -- and "stnsd -t" will say so before you rely on it.

# The port to listen on, and optionally the address.  Without "listen" every
# address is used; with it, only that one.
port = 1104
#listen = "127.0.0.1:1104"

# Read more files into this one.  A relative path is taken from the directory
# of the file naming it, and a pattern is expanded, so an empty conf.d is a
# perfectly ordinary state of affairs -- but a plain path that is not there is
# an error, since somebody meant to include something.
#include = "conf.d/*.conf"

# Who may connect at all.  Absent, everybody may; present, only these.  The
# list is checked against the address the connection came from, before the TLS
# handshake -- which also means a health check has to be in it.
#allow_ips = ["10.0.0.0/8", "192.168.1.5", "2001:db8::/32", "::1"]

# Take the listening sockets from a supervisor (Server::Starter and the like)
# through SERVER_STARTER_PORT, instead of binding them.  For restarts that keep
# the socket open; the server refuses to start if no supervisor handed it one.
#use_server_starter = false

# Authentication.  Either is optional and both may be given, in which case
# either satisfies the server.  /v1/status and / never require credentials, so
# that a health check does not need one.
#[token_auth]
#tokens = ["xxxxxxxxxxxxxxxx"]

#[basic_auth]
#user = "stns"
#password = "secret"

# Keys published on github, fetched when this file is read and never while
# serving a request.  The fetcher is the system's own client -- ftp(1) here --
# so that its idea of which certificates to trust is the one that applies; on
# NetBSD that means security/mozilla-rootcerts has to be installed.  What was
# fetched is cached, and the cache is used when a fetch fails, so github being
# unreachable makes the keys old rather than absent.
#[github]
#url     = "https://github.com/%s.keys"
#fetcher = "ftp -o -"
#cache   = "/var/db/stnsd/github"

# TLS.  cert and key serve HTTPS; adding ca additionally requires the client to
# present a certificate signed by it, which is worth more than a token here --
# a token travels with every request, a client certificate stays put.  Half a
# configuration is refused at start up, so "stnsd -t" will tell you.
#[tls]
#cert = "/usr/pkg/etc/stns/server/server.pem"
#key  = "/usr/pkg/etc/stns/server/server-key.pem"
#ca   = "/usr/pkg/etc/stns/server/ca.pem"

# Users.  The table name is the account name.  Only id is required; everything
# else has the same defaults the client applies -- an empty shell becomes
# /bin/sh and an empty directory /home/<name>, decided by the client rather
# than here, so that one directory can serve machines that disagree.
[users.example]
id = 10001
group_id = 10001
directory = "/home/example"
shell = "/bin/sh"
gecos = "An example account"
# The hash a client hands to pam_unix(8).  Generate it with pwhash(1) on
# NetBSD.  A client only reveals it to a caller running as root.
#password = "$6$xxxxxxxx$xxxxxxxx"
keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... example",
]

# link_users names other users whose keys become this account's keys as well,
# following on through their own link_users.  Handy for a shared account that
# several people log into: the account has no keys of its own and lists them.
#[users.deploy]
#id = 10002
#group_id = 10001
#link_users = ["example"]

# Groups.  "users" are the member names; link_groups pulls in the members of
# another group, transitively, the same way link_users pulls in keys.
[groups.example]
id = 10001
users = ["example"]

#[groups.ops]
#id = 10002
#users = ["deploy"]
#link_groups = ["example"]
